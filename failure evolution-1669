def simulate_zhuhai_hato_mc() -> None:
    """Docstring."""

    OUTPUT_DIR.mkdir(exist_ok=True)
    clean_non_key_outputs()

    network, nodes, edges, line_geometries = build_zhuhai_network_mc()
    track = resample_track_to_step(read_hato_track(), TIME_STEP_H)
    baseline = compute_network_metrics_baseline(network)

    exposure = nodes[["id", "lon", "lat"]].copy()
    exposure["height_m"] = 44.0

    tower_exposure, edges = build_synthetic_tower_exposure(edges, nodes, line_geometries)
    if len(tower_exposure) == 0:
        raise ValueError("No synthetic tower exposure points were generated.")

    wind_matrix, tower_wind_matrix, climada_used = run_climada_windfield(track, exposure, tower_exposure)
    safe_to_csv(wind_matrix, OUTPUT_DIR / "climada_node_wind_timeseries.csv")
    safe_to_csv(tower_wind_matrix, OUTPUT_DIR / "climada_tower_wind_timeseries.csv")
    write_wind_diagnosis(track, nodes, tower_exposure, wind_matrix, tower_wind_matrix)

    cumulative_node = wind_matrix.drop(columns=["time"], errors="ignore").cummax()
    cumulative_tower = tower_wind_matrix.drop(columns=["time"], errors="ignore").cummax()
    node_ids = exposure["id"].astype(str).tolist()
    tower_ids = tower_exposure["id"].astype(str).tolist()
    edge_ids = edges["edge_id"].astype(str).tolist()
    edge_lookup = edges.set_index("edge_id")
    node_xy = {row["id"]: (float(row["lon"]), float(row["lat"])) for _, row in nodes.iterrows()}
    tower_index = {tower_id: idx for idx, tower_id in enumerate(tower_ids)}
    edge_tower_index_map: dict[str, np.ndarray] = {}
    for edge_id in edge_ids:
        tower_list = parse_tower_ids(edge_lookup.loc[edge_id, "tower_ids"])
        edge_tower_index_map[edge_id] = np.asarray([tower_index[tower_id] for tower_id in tower_list if tower_id in tower_index], dtype=int)

    rng = np.random.default_rng(RANDOM_SEED)
    node_failed = np.zeros((MONTE_CARLO_SAMPLES, len(node_ids)), dtype=bool)
    edge_tower_failed_state = {
        edge_id: np.zeros((MONTE_CARLO_SAMPLES, len(edge_tower_index_map[edge_id])), dtype=bool)
        for edge_id in edge_ids
    }

    failure_times: dict[str, pd.Timestamp] = {}
    cumulative_expected_failed_towers: dict[str, float] = {edge_id: 0.0 for edge_id in edge_ids}
    cumulative_max_tower_failure_probability: dict[str, float] = {edge_id: 0.0 for edge_id in edge_ids}
    cumulative_mean_damaged: dict[str, float] = {edge_id: 0.0 for edge_id in edge_ids}
    cumulative_slight_prob: dict[str, float] = {edge_id: 0.0 for edge_id in edge_ids}
    cumulative_severe_prob: dict[str, float] = {edge_id: 0.0 for edge_id in edge_ids}
    edge_mean_state_last: dict[str, float] = {edge_id: 1.0 for edge_id in edge_ids}
    tower_failure_detail_rows: list[dict[str, object]] = []
    timeline_rows: list[dict[str, object]] = []

    for time_idx, (_, node_row) in enumerate(cumulative_node.iterrows()):
        tower_row = cumulative_tower.iloc[time_idx]
        track_point = track.iloc[time_idx]

        node_intensity = node_row[node_ids].to_numpy(dtype=float)
        node_p_fail = np.asarray([station_binary_failure_probability(value) for value in node_intensity], dtype=float)
        node_new_fail = (~node_failed) & (rng.random(node_failed.shape) < node_p_fail[None, :])
        node_failed |= node_new_fail

        edge_state_samples = np.ones((MONTE_CARLO_SAMPLES, len(edge_ids)), dtype=float)
        mean_damaged_counts = np.zeros(len(edge_ids), dtype=float)
        slight_probabilities = np.zeros(len(edge_ids), dtype=float)
        severe_probabilities = np.zeros(len(edge_ids), dtype=float)
        expected_failed_counts = np.zeros(len(edge_ids), dtype=float)
        max_failure_probabilities = np.zeros(len(edge_ids), dtype=float)

        for edge_pos, edge_id in enumerate(edge_ids):
            edge_meta = edge_lookup.loc[edge_id]
            line_bearing = edge_bearing(edge_meta, node_xy)
            edge_function, expected_failed, max_pf, tower_probabilities, detail_rows = compute_edge_function_from_towers(
                edge_meta,
                tower_row,
                tower_exposure,
                track_point,
                line_bearing,
            )
            if SAVE_DEBUG_TABLES:
                tower_failure_detail_rows.extend(detail_rows)

            tower_state = edge_tower_failed_state[edge_id]
            if len(tower_probabilities) > 0:
                tower_new_fail = (~tower_state) & (rng.random(tower_state.shape) < tower_probabilities[None, :])
                tower_state |= tower_new_fail
                counts = tower_state.sum(axis=1)
                edge_state_samples[:, edge_pos] = np.where(counts == 0, 1.0, np.where(counts < 3, 0.8, 0.0))
                mean_damaged_counts[edge_pos] = float(np.mean(counts))
                slight_probabilities[edge_pos] = float(np.mean((counts > 0) & (counts < 3)))
                severe_probabilities[edge_pos] = float(np.mean(counts >= 3))
                expected_failed_counts[edge_pos] = float(expected_failed)
                max_failure_probabilities[edge_pos] = float(max_pf)
            else:
                counts = np.zeros(MONTE_CARLO_SAMPLES, dtype=float)
                edge_state_samples[:, edge_pos] = 1.0

            edge_mean_state = float(edge_state_samples[:, edge_pos].mean())
            edge_mean_state_last[edge_id] = edge_mean_state
            cumulative_expected_failed_towers[edge_id] = float(expected_failed_counts[edge_pos])
            cumulative_max_tower_failure_probability[edge_id] = float(max_failure_probabilities[edge_pos])
            cumulative_mean_damaged[edge_id] = float(mean_damaged_counts[edge_pos])
            cumulative_slight_prob[edge_id] = float(slight_probabilities[edge_pos])
            cumulative_severe_prob[edge_id] = float(severe_probabilities[edge_pos])
            if edge_mean_state < 0.99 and edge_id not in failure_times:
                failure_times[edge_id] = pd.Timestamp(track_point["time"])

        sample_kte = np.zeros(MONTE_CARLO_SAMPLES, dtype=float)
        sample_ktr = np.zeros(MONTE_CARLO_SAMPLES, dtype=float)
        sample_klc = np.zeros(MONTE_CARLO_SAMPLES, dtype=float)
        sample_k = np.zeros(MONTE_CARLO_SAMPLES, dtype=float)
        for sample_idx in range(MONTE_CARLO_SAMPLES):
            sample_network = network.copy()
            for node_pos, node_id in enumerate(node_ids):
                sample_network.nodes[node_id].function_state = 0.0 if node_failed[sample_idx, node_pos] else 1.0
            for edge_pos, edge_id in enumerate(edge_ids):
                sample_network.edges[edge_id].function_state = float(edge_state_samples[sample_idx, edge_pos])
            metrics = compute_network_metrics_baseline(sample_network, baseline=baseline)
            sample_kte[sample_idx] = metrics.kte
            sample_ktr[sample_idx] = metrics.ktr
            sample_klc[sample_idx] = metrics.klc
            sample_k[sample_idx] = metrics.k

        damaged_edge_count = float(np.mean((edge_state_samples < 0.99).sum(axis=1)))
        timeline_rows.append(
            {
                "time": track_point["time"],
                "max_node_wind_ms": float(node_row.max()),
                "max_tower_wind_ms": float(tower_row.max()),
                "KTE_norm": float(sample_kte.mean()),
                "KTR_norm": float(sample_ktr.mean()),
                "KLC_norm": float(sample_klc.mean()),
                "K": float(sample_k.mean()),
                "function_percent": float(sample_k.mean() * 100.0),
                "damaged_edge_count": damaged_edge_count,
            }
        )

    if SAVE_DEBUG_TABLES and tower_failure_detail_rows:
        safe_to_csv(pd.DataFrame(tower_failure_detail_rows), OUTPUT_DIR / "tower_failure_details.csv")

    edges["final_function_state"] = [edge_mean_state_last[edge_id] for edge_id in edges["edge_id"].astype(str)]
    edges["expected_failed_towers"] = [cumulative_expected_failed_towers[edge_id] for edge_id in edges["edge_id"].astype(str)]
    edges["max_tower_failure_probability"] = [cumulative_max_tower_failure_probability[edge_id] for edge_id in edges["edge_id"].astype(str)]
    edges["mean_damaged_tower_count"] = [cumulative_mean_damaged[edge_id] for edge_id in edges["edge_id"].astype(str)]
    edges["mean_slight_damage_probability"] = [cumulative_slight_prob[edge_id] for edge_id in edges["edge_id"].astype(str)]
    edges["mean_severe_damage_probability"] = [cumulative_severe_prob[edge_id] for edge_id in edges["edge_id"].astype(str)]
    edges["damage_level_expected"] = edges["expected_failed_towers"].apply(damage_level_from_count)
    edges["is_damaged"] = edges["final_function_state"] < 0.99
    edges["failure_time"] = edges["edge_id"].map(failure_times)
    failed_order = (
        edges[edges["is_damaged"] & edges["failure_time"].notna()]
        .sort_values(["failure_time", "edge_id"])
        .reset_index(drop=True)
    )
    order_map = {edge_id: order + 1 for order, edge_id in enumerate(failed_order["edge_id"])}
    edges["failure_order"] = edges["edge_id"].map(order_map)

    safe_to_csv(edges[[
        "edge_id",
        "source",
        "target",
        "tower_count",
        "expected_failed_towers",
        "max_tower_failure_probability",
        "final_function_state",
        "damage_level_expected",
        "failure_time",
        "failure_order",
        "mean_damaged_tower_count",
        "mean_slight_damage_probability",
        "mean_severe_damage_probability",
    ]], OUTPUT_DIR / "zhuhai_network_edges.csv")

    timeline = pd.DataFrame(timeline_rows)
    safe_to_csv(timeline[[
        "time",
        "max_node_wind_ms",
        "max_tower_wind_ms",
        "KTE_norm",
        "KTR_norm",
        "KLC_norm",
        "K",
        "function_percent",
        "damaged_edge_count",
    ]], OUTPUT_DIR / "zhuhai_hato_failure_timeline.csv")

    print(f"CLIMADA windfield used: {climada_used}")
    print(f"Time step: {TIME_STEP_H}h")
    print(f"Node exposure count: {len(exposure)}")
    print(f"Tower exposure count: {len(tower_exposure)}")
    print(f"Max node wind speed: {timeline['max_node_wind_ms'].max():.2f} m/s")
    print(f"Max tower wind speed: {timeline['max_tower_wind_ms'].max():.2f} m/s")
    print(f"Minimum system function: {timeline['function_percent'].min():.2f}%")
    print(f"Damaged / affected edge count: {int(edges['is_damaged'].sum())}")
    print("Key output files saved:")
    for name in [
        "climada_node_wind_timeseries.csv",
        "climada_tower_wind_timeseries.csv",
        "zhuhai_hato_failure_timeline.csv",
        "zhuhai_network_edges.csv",
        "wind_diagnosis.csv",
        "zhuhai_network_map.png",
        "zhuhai_function_timeline.png",
        "zhuhai_wind_timeline.png",
    ]:
        print(f"- outputs/{name}")

    plot_zhuhai_network(nodes, edges, tower_exposure, track)
    plot_zhuhai_timelines(timeline)


def plot_zhuhai_network(
    nodes: pd.DataFrame,
    edges: pd.DataFrame,
    towers: gpd.GeoDataFrame,
    track: pd.DataFrame,
) -> None:
    """Docstring."""

    try:
        import matplotlib.pyplot as plt
        from matplotlib.lines import Line2D
        from shapely.geometry import LineString, box

        boundary = gpd.read_file(RAW_DIR / "zhuhai_boundary.shp").to_crs("EPSG:4326")
        minx, miny, maxx, maxy = boundary.total_bounds
        pad_x = (maxx - minx) * 0.08
        pad_y = (maxy - miny) * 0.08
        plot_minx = minx - pad_x
        plot_maxx = maxx + pad_x
        plot_miny = miny - pad_y
        plot_maxy = maxy + pad_y
        track_buffer_x = 0.8
        track_buffer_y = 0.8
        track_local = track[
            (track["lon"] >= minx - track_buffer_x)
            & (track["lon"] <= maxx + track_buffer_x)
            & (track["lat"] >= miny - track_buffer_y)
            & (track["lat"] <= maxy + track_buffer_y)
        ].copy()
        if len(track_local) < 2:
            track_buffer_x = 1.2
            track_buffer_y = 1.2
            track_local = track[
                (track["lon"] >= minx - track_buffer_x)
                & (track["lon"] <= maxx + track_buffer_x)
                & (track["lat"] >= miny - track_buffer_y)
                & (track["lat"] <= maxy + track_buffer_y)
            ].copy()

        fig, ax = plt.subplots(figsize=(9, 8))
        boundary.boundary.plot(ax=ax, color="black", linewidth=1)
        xy = {row["id"]: (row["lon"], row["lat"]) for _, row in nodes.iterrows()}
        lines_gdf = gpd.read_file(RAW_DIR / "lines.shp").to_crs("EPSG:4326")
        line_geometries = {int(row["FID_PowerT"]): row.geometry for _, row in lines_gdf.iterrows()}

        def plot_edge_geometry(edge: pd.Series, color: str, linewidth: float, alpha: float, zorder: int) -> None:
            line_fid = edge.get("line_fid", np.nan)
            if pd.notna(line_fid) and int(line_fid) in line_geometries:
                geometry = line_geometries[int(line_fid)]
                geometries = list(geometry.geoms) if geometry.geom_type == "MultiLineString" else [geometry]
                for geom in geometries:
                    xs, ys = geom.xy
                    ax.plot(xs, ys, color=color, linewidth=linewidth, alpha=alpha, zorder=zorder)
                return
            if edge["source"] in xy and edge["target"] in xy:
                sx, sy = xy[edge["source"]]
                tx, ty = xy[edge["target"]]
                ax.plot([sx, tx], [sy, ty], color=color, linewidth=linewidth, alpha=alpha, zorder=zorder)

        def edge_is_failed(edge: pd.Series) -> bool:
            return str(edge.get("is_damaged", False)).lower() in {"true", "1"}

        normal_edges = edges[~edges.apply(edge_is_failed, axis=1)]
        failed_edges = edges[edges.apply(edge_is_failed, axis=1)]

        for _, edge in normal_edges.iterrows():
            plot_edge_geometry(edge, color="#6c757d", linewidth=1, alpha=0.65, zorder=1)

        for _, edge in failed_edges.iterrows():
            if edge["source"] not in xy or edge["target"] not in xy:
                continue
            plot_edge_geometry(edge, color="red", linewidth=1.8, alpha=0.95, zorder=4)
            if pd.notna(edge.get("failure_order", np.nan)):
                line_fid = edge.get("line_fid", np.nan)
                if pd.notna(line_fid) and int(line_fid) in line_geometries:
                    midpoint = line_geometries[int(line_fid)].interpolate(0.5, normalized=True)
                    mx, my = midpoint.x, midpoint.y
                else:
                    sx, sy = xy[edge["source"]]
                    tx, ty = xy[edge["target"]]
                    mx = (sx + tx) / 2.0
                    my = (sy + ty) / 2.0
                ax.text(
                    mx,
                    my,
                    str(int(edge["failure_order"])),
                    fontsize=7,
                    color="darkred",
                    ha="center",
                    va="center",
                    zorder=6,
                    bbox={"boxstyle": "round,pad=0.12", "fc": "white", "ec": "none", "alpha": 0.75},
                )
        plants = nodes[nodes["type"] == "plant"]
        substations = nodes[nodes["type"] == "substation"]
        ax.scatter(plants["lon"], plants["lat"], s=18, c="#f4a261", marker="o", label="plants", zorder=3)
        ax.scatter(substations["lon"], substations["lat"], s=22, c="#2a9d8f", marker="o", label="substations", zorder=3)
        ax.scatter(
            towers.geometry.x,
            towers.geometry.y,
            s=2.5,
            facecolors="none",
            edgecolors="#277da1",
            linewidths=0.28,
            marker="^",
            label="towers",
            alpha=0.32,
            zorder=2,
        )

        if len(track_local) >= 2:
            map_box = box(plot_minx, plot_miny, plot_maxx, plot_maxy)
            clipped = LineString(list(zip(track_local["lon"], track_local["lat"]))).intersection(map_box)
            if not clipped.is_empty:
                segments = [clipped] if clipped.geom_type == "LineString" else list(clipped.geoms)
                for segment in segments:
                    coords = list(segment.coords)
                    if len(coords) < 2:
                        continue
                    xs, ys = zip(*coords)
                    ax.plot(xs, ys, color="blue", linestyle="--", linewidth=1.5, alpha=0.8, label="typhoon path", zorder=3)
                    ax.scatter(xs, ys, s=12, c="blue", alpha=0.8, zorder=3)
                    start = coords[0]
                    end = coords[-1]
                    ax.annotate(
                        "",
                        xy=end,
                        xytext=start,
                        arrowprops={"arrowstyle": "->", "color": "blue", "lw": 1.0, "alpha": 0.8},
                        zorder=3,
                        clip_on=True,
                    )
                visible_points = track_local[
                    (track_local["lon"] >= plot_minx)
                    & (track_local["lon"] <= plot_maxx)
                    & (track_local["lat"] >= plot_miny)
                    & (track_local["lat"] <= plot_maxy)
                ]
                step = 2 if len(visible_points) <= 12 else 3
                for local_order, (_, point) in enumerate(visible_points.iloc[::step].iterrows(), start=1):
                    ax.text(point["lon"], point["lat"], str(local_order), fontsize=6, color="blue", zorder=5, clip_on=True)

        legend_handles = [
            Line2D([0], [0], color="#6c757d", lw=1.5, label="normal lines"),
            Line2D([0], [0], color="red", lw=1.5, label="failed lines"),
            Line2D([0], [0], marker="o", color="w", markerfacecolor="#f4a261", markersize=6, label="plants"),
            Line2D([0], [0], marker="o", color="w", markerfacecolor="#2a9d8f", markersize=6, label="substations"),
            Line2D([0], [0], marker="^", color="#277da1", markerfacecolor="none", markeredgecolor="#277da1", linestyle="None", markersize=4, label="towers"),
            Line2D([0], [0], color="#1d4ed8", linestyle="--", lw=1.4, label="typhoon path"),
        ]
        ax.set_title("Zhuhai power infrastructure network")
        ax.set_xlabel("longitude")
        ax.set_ylabel("latitude")
        ax.legend(handles=legend_handles, loc="best", fontsize=8)
        ax.set_aspect("equal", adjustable="box")
        ax.set_xlim(plot_minx, plot_maxx)
        ax.set_ylim(plot_miny, plot_maxy)
        fig.tight_layout()
        fig.savefig(OUTPUT_DIR / "zhuhai_network_map.png", dpi=200)
        plt.close(fig)
    except Exception as exc:
        print(f"Map output skipped: {exc}")


def plot_zhuhai_timelines(timeline: pd.DataFrame) -> None:
    """Docstring."""

    try:
        import matplotlib.pyplot as plt

        time = pd.to_datetime(timeline["time"])

        fig, ax = plt.subplots(figsize=(9, 4.5))
        ax.plot(time, timeline["function_percent"], color="#d62828", linewidth=1.8)
        min_idx = timeline["function_percent"].idxmin()
        ax.scatter(time.loc[min_idx], timeline.loc[min_idx, "function_percent"], color="#d62828", s=28, zorder=3)
        ax.annotate(
            f"min={timeline.loc[min_idx, 'function_percent']:.2f}%",
            xy=(time.loc[min_idx], timeline.loc[min_idx, "function_percent"]),
            xytext=(8, 8),
            textcoords="offset points",
            fontsize=8,
        )
        ax.set_title("Zhuhai system function timeline")
        ax.set_xlabel("time")
        ax.set_ylabel("function (%)")
        ax.grid(alpha=0.25)
        fig.autofmt_xdate()
        fig.tight_layout()
        fig.savefig(OUTPUT_DIR / "zhuhai_function_timeline.png", dpi=200)
        plt.close(fig)

        fig, ax = plt.subplots(figsize=(9, 4.5))
        ax.plot(time, timeline["max_node_wind_ms"], label="max node wind", linewidth=1)
        ax.plot(time, timeline["max_tower_wind_ms"], label="max tower wind", linewidth=1)
        ax.set_title("Zhuhai maximum wind timeline")
        ax.set_xlabel("time")
        ax.set_ylabel("wind speed (m/s)")
        ax.legend()
        ax.grid(alpha=0.25)
        fig.autofmt_xdate()
        fig.tight_layout()
        fig.savefig(OUTPUT_DIR / "zhuhai_wind_timeline.png", dpi=200)
        plt.close(fig)
    except Exception as exc:
        print(f"Timeline figures skipped: {exc}")


