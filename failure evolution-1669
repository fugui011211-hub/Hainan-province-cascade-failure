def run_climada_windfield(
    track: pd.DataFrame,
    node_exposure: pd.DataFrame,
    tower_exposure: pd.DataFrame,
) -> tuple[pd.DataFrame, pd.DataFrame, bool]:
    """Docstring."""

    if not USE_CLIMADA_WINDFIELD:
        node_wind = compute_wind_time_series(track, node_exposure)
        tower_wind = compute_wind_time_series(track, tower_exposure)
        return node_wind, tower_wind, False

    try:
        from climada.hazard import Centroids, TCTracks, TropCyclone

        processed_path = make_climada_processed_track_csv(track)
        tc_tracks = TCTracks.from_processed_ibtracs_csv(str(processed_path))
        if not SAVE_DEBUG_TABLES:
            try:
                processed_path.unlink()
            except OSError:
                pass
        all_exposure = pd.concat(
            [
                node_exposure[["id", "lon", "lat"]],
                tower_exposure[["id", "lon", "lat"]],
            ],
            ignore_index=True,
        )
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            centroids = Centroids.from_lat_lon(all_exposure["lat"].to_numpy(), all_exposure["lon"].to_numpy())
        hazard = TropCyclone.from_tracks(
            tc_tracks,
            centroids=centroids,
            store_windfields=True,
            intensity_thres=0,
            max_dist_eye_km=1000,
            ignore_distance_to_coast=True,
        )
        wind_vectors = hazard.windfields[0].toarray()
        wind_speed = np.sqrt(wind_vectors[:, 0::2] ** 2 + wind_vectors[:, 1::2] ** 2)
        wind_df = pd.DataFrame(wind_speed, columns=all_exposure["id"].astype(str))
        wind_df.insert(0, "time", track["time"].to_numpy())

        node_ids = node_exposure["id"].astype(str).tolist()
        tower_ids = tower_exposure["id"].astype(str).tolist()
        node_wind = wind_df[["time"] + node_ids].copy()
        tower_wind = wind_df[["time"] + tower_ids].copy()
        return node_wind, tower_wind, True
    except Exception as exc:
        print(f"CLIMADA windfield failed, fallback to internal wind field: {exc}")
        node_wind = compute_wind_time_series(track, node_exposure)
        tower_wind = compute_wind_time_series(track, tower_exposure)
        return node_wind, tower_wind, False


def write_wind_diagnosis(
    track: pd.DataFrame,
    nodes: pd.DataFrame,
    towers: pd.DataFrame,
    node_wind: pd.DataFrame,
    tower_wind: pd.DataFrame,
) -> None:
    """Docstring."""

    pressure_vmax = track.apply(
        lambda row: max_wind_speed_ms(
            float(row["center_pressure_hpa"]),
            float(row["lat"]),
            float(row.get("movement_speed_ms", 0.0)),
        ),
        axis=1,
    )

    def min_track_distance(exposure: pd.DataFrame) -> float:
        best = float("inf")
        for _, point in track.iterrows():
            for _, asset in exposure.iterrows():
                best = min(best, distance_m(point["lon"], point["lat"], asset["lon"], asset["lat"]))
        return best

    node_values = node_wind.drop(columns=["time"], errors="ignore")
    tower_values = tower_wind.drop(columns=["time"], errors="ignore")
    node_max = float(node_values.max().max()) if not node_values.empty else 0.0
    tower_max = float(tower_values.max().max()) if not tower_values.empty else 0.0
    diagnosis = pd.DataFrame(
        [
            {
                "max_track_wind_ms": float(track["max_wind_speed_ms"].max(skipna=True)),
                "min_center_pressure_hpa": float(track["center_pressure_hpa"].min()),
                "max_node_wind_ms": node_max,
                "max_tower_wind_ms": tower_max,
                "nearest_track_to_node_m": min_track_distance(nodes[["id", "lon", "lat"]]),
                "nearest_track_to_tower_m": min_track_distance(towers[["id", "lon", "lat"]]),
            }
        ]
    )
    safe_to_csv(diagnosis, OUTPUT_DIR / "wind_diagnosis.csv")


def compute_edge_function_from_towers(
    edge: pd.Series,
    tower_row: pd.Series,
    tower_exposure: pd.DataFrame,
    track_point: pd.Series,
    line_bearing: float,
) -> tuple[float, float, float, np.ndarray, list[dict[str, object]]]:
    """Docstring."""

    tower_ids = [tower_id for tower_id in parse_tower_ids(edge.get("tower_ids")) if tower_id in tower_row.index]
    if not tower_ids:
        return np.nan, np.nan, np.nan, np.asarray([]), []

    tower_xy = tower_exposure.set_index("id")[["lon", "lat"]]
    edge_id = edge.get("edge_id", edge.name)
    failure_probs = []
    detail_rows = []
    for tower_id in tower_ids:
        wind_speed = float(tower_row[tower_id])
        tower_lon = float(tower_xy.loc[tower_id, "lon"])
        tower_lat = float(tower_xy.loc[tower_id, "lat"])
        radial_bearing = bearing_deg(float(track_point["lon"]), float(track_point["lat"]), tower_lon, tower_lat)
        local_wind_direction = (radial_bearing + 90.0) % 360.0
        relative_direction = folded_angle_0_90(local_wind_direction, line_bearing)
        direction_bin = nearest_direction_bin(relative_direction)
        selected_mu, selected_beta = TOWER_DIRECTIONAL_FRAGILITY[direction_bin]
        failure_probability = fragility_probability_log_median(wind_speed, selected_mu, selected_beta)
        failure_probs.append(failure_probability)
        detail_rows.append(
            {
                "time": track_point["time"],
                "edge_id": edge_id,
                "tower_id": tower_id,
                "tower_wind_ms": wind_speed,
                "line_bearing": line_bearing,
                "local_wind_direction": local_wind_direction,
                "relative_direction": relative_direction,
                "direction_bin": direction_bin,
                "selected_mu": selected_mu,
                "selected_beta": selected_beta,
                "tower_failure_probability": failure_probability,
            }
        )

    probabilities = np.asarray(failure_probs, dtype=float)
    line_survival_probability = float(np.prod(1.0 - probabilities))
    expected_failed_towers = float(probabilities.sum())
    max_tower_failure_probability = float(probabilities.max())
    return line_survival_probability, expected_failed_towers, max_tower_failure_probability, probabilities, detail_rows


def simulate_zhuhai_hato() -> None:
    """Docstring."""

    OUTPUT_DIR.mkdir(exist_ok=True)
    clean_non_key_outputs()
    network, nodes, edges = build_zhuhai_network()
    _, _, towers, _, _ = read_zhuhai_assets()
    baseline = network.functional_metrics()
    track = read_hato_track()

    exposure = nodes[["id", "lon", "lat"]].copy()
    exposure["height_m"] = 44.0
    tower_exposure = build_tower_exposure(towers)
    wind_matrix, tower_wind_matrix, climada_used = run_climada_windfield(track, exposure, tower_exposure)
    safe_to_csv(wind_matrix, OUTPUT_DIR / "climada_node_wind_timeseries.csv")
    safe_to_csv(tower_wind_matrix, OUTPUT_DIR / "climada_tower_wind_timeseries.csv")
    write_wind_diagnosis(track, nodes, tower_exposure, wind_matrix, tower_wind_matrix)

    cumulative = wind_matrix.drop(columns=["time"]).cummax()
    tower_cumulative = tower_wind_matrix.drop(columns=["time"]).cummax()
    timeline_rows = []
    cumulative_edge_functions = {edge_id: 1.0 for edge_id in edges["edge_id"]}
    cumulative_expected_failed_towers = {edge_id: 0.0 for edge_id in edges["edge_id"]}
    cumulative_max_tower_failure_probability = {edge_id: 0.0 for edge_id in edges["edge_id"]}
    cumulative_mc_mean_damaged = {edge_id: 0.0 for edge_id in edges["edge_id"]}
    cumulative_mc_slight_probability = {edge_id: 0.0 for edge_id in edges["edge_id"]}
    cumulative_mc_severe_probability = {edge_id: 0.0 for edge_id in edges["edge_id"]}
    failure_times = {}
    tower_failure_detail_rows = []
    rng = np.random.default_rng(RANDOM_SEED)
    edge_lookup = edges.set_index("edge_id")
    node_xy = {node["id"]: (node["lon"], node["lat"]) for _, node in nodes.iterrows()}
    for i, row in cumulative.iterrows():
        tower_row = tower_cumulative.iloc[i]
        track_point = track.iloc[i]
        damaged_network = network.copy()
        for node_id in nodes["id"]:
            intensity = float(row[node_id])
            damaged_network.nodes[node_id].function_state = expected_component_function(intensity, PLANT_SUBSTATION_FRAGILITY)

        damaged_edge_count = 0
        for edge in damaged_network.edges.values():
            edge_meta = edge_lookup.loc[edge.edge_id]
            line_bearing = edge_bearing(edge_meta, node_xy)
            edge_function, expected_failed, max_pf, tower_probabilities, detail_rows = compute_edge_function_from_towers(
                edge_meta,
                tower_row,
                tower_exposure,
                track_point,
                line_bearing,
            )
            tower_failure_detail_rows.extend(detail_rows)
            if pd.isna(edge_function):
                edge_function = 1.0
                expected_failed = 0.0
                max_pf = 0.0
                tower_probabilities = np.asarray([])

            if SIMULATION_MODE == "monte_carlo" and len(tower_probabilities) > 0:
                samples = rng.random((MONTE_CARLO_SAMPLES, len(tower_probabilities))) < tower_probabilities
                damaged_counts = samples.sum(axis=1)
                mean_damaged = float(damaged_counts.mean())
                slight_probability = float(((damaged_counts > 0) & (damaged_counts < 3)).mean())
                severe_probability = float((damaged_counts >= 3).mean())
                edge_function = float((damaged_counts == 0).mean() + 0.8 * slight_probability)
                cumulative_mc_mean_damaged[edge.edge_id] = max(cumulative_mc_mean_damaged[edge.edge_id], mean_damaged)
                cumulative_mc_slight_probability[edge.edge_id] = max(cumulative_mc_slight_probability[edge.edge_id], slight_probability)
                cumulative_mc_severe_probability[edge.edge_id] = max(cumulative_mc_severe_probability[edge.edge_id], severe_probability)

            cumulative_edge_functions[edge.edge_id] = min(cumulative_edge_functions[edge.edge_id], edge_function)
            cumulative_expected_failed_towers[edge.edge_id] = max(cumulative_expected_failed_towers[edge.edge_id], expected_failed)
            cumulative_max_tower_failure_probability[edge.edge_id] = max(cumulative_max_tower_failure_probability[edge.edge_id], max_pf)
            edge.function_state = cumulative_edge_functions[edge.edge_id]
            if edge.function_state < 0.99 and edge.edge_id not in failure_times:
                failure_times[edge.edge_id] = wind_matrix.loc[i, "time"]
            if edge.function_state < 0.99:
                damaged_edge_count += 1

        metrics = damaged_network.functional_metrics(baseline=baseline)
        timeline_rows.append(
            {
                "time": wind_matrix.loc[i, "time"],
                "max_wind_ms": float(row.max()),
                "max_node_wind_ms": float(row.max()),
                "max_tower_wind_ms": float(tower_row.max()),
                "KTE": metrics.kte,
                "KTR": metrics.ktr,
                "KLC": metrics.klc,
                "KLC": metrics.klc,
                "KTE_norm": safe_ratio(metrics.kte, baseline.kte),
                "KTR_norm": safe_ratio(metrics.ktr, baseline.ktr),
                "KLC_norm": safe_ratio(metrics.klc, baseline.klc),
                "K": metrics.k,
                "function_percent": metrics.k * 100.0,
                "damaged_edge_count": damaged_edge_count,
            }
        )

    if SAVE_DEBUG_TABLES:
        safe_to_csv(nodes, OUTPUT_DIR / "zhuhai_network_nodes.csv")
        safe_to_csv(pd.DataFrame(tower_failure_detail_rows), OUTPUT_DIR / "tower_failure_details.csv")
    if not edges.empty:
        keep_cols = [
            "edge_id",
            "source",
            "target",
            "tower_count",
            "expected_failed_towers",
            "max_tower_failure_probability",
            "final_function_state",
            "damage_level_expected",
            "failure_time",
            "failure_order",
        ]
        edges["final_function_state"] = edges["edge_id"].map(cumulative_edge_functions)
        edges["expected_failed_towers"] = edges["edge_id"].map(cumulative_expected_failed_towers)
        edges["damage_level_expected"] = edges["expected_failed_towers"].apply(damage_level_from_count)
        edges["max_tower_failure_probability"] = edges["edge_id"].map(cumulative_max_tower_failure_probability)
        if SIMULATION_MODE == "monte_carlo":
            edges["mean_damaged_tower_count"] = edges["edge_id"].map(cumulative_mc_mean_damaged)
            edges["mean_slight_damage_probability"] = edges["edge_id"].map(cumulative_mc_slight_probability)
            edges["mean_severe_damage_probability"] = edges["edge_id"].map(cumulative_mc_severe_probability)
        edges["is_damaged"] = edges["final_function_state"] < 0.99
        edges["failure_time"] = edges["edge_id"].map(failure_times)
        failed_order = (
            edges[edges["is_damaged"] & edges["failure_time"].notna()]
            .sort_values(["failure_time", "edge_id"])
            .reset_index(drop=True)
        )
        order_map = {edge_id: order + 1 for order, edge_id in enumerate(failed_order["edge_id"])}
