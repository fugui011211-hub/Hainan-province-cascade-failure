    df["max_wind_speed_ms"] = wind.mask(wind <= 0) * 0.514444
    rmw = pd.to_numeric(df.get("USA_RMW", np.nan), errors="coerce")
    df["radius_max_wind_nm"] = rmw.mask(rmw <= 0).fillna(30.0)
