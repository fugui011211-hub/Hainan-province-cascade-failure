        [
            "time",
            "lon",
            "lat",
            "center_pressure_hpa",
            "movement_speed_ms",
            "max_wind_speed_ms",
            "radius_max_wind_nm",
        ]
    ].dropna(subset=["lon", "lat"])


def resample_track_to_step(track: pd.DataFrame, step_hours: int = 3) -> pd.DataFrame:
    """Docstring."""

    if track.empty or len(track) < 2:
        return track.copy()

    work = track.sort_values("time").copy().set_index("time")
    freq = f"{int(step_hours)}h"
    full_index = pd.date_range(work.index.min(), work.index.max(), freq=freq)
    numeric_cols = [
        col
        for col in ["lon", "lat", "center_pressure_hpa", "movement_speed_ms", "max_wind_speed_ms", "radius_max_wind_nm"]
        if col in work.columns
    ]
    work = work.reindex(work.index.union(full_index)).sort_index()
    if numeric_cols:
        work[numeric_cols] = work[numeric_cols].interpolate(method="time").ffill().bfill()
    work = work.loc[full_index].reset_index().rename(columns={"index": "time"})
    return work[track.columns]


def safe_to_csv(df: pd.DataFrame, path: Path) -> Path:
    """Docstring."""

    try:
        df.to_csv(path, index=False, encoding="utf-8-sig")
        return path
    except PermissionError:
        fallback = path.with_name(f"{path.stem}_updated{path.suffix}")
        df.to_csv(fallback, index=False, encoding="utf-8-sig")
        print(f"Warning: {path} is locked. Wrote {fallback} instead.")
        return fallback


