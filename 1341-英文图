def load_data():
    df = pd.read_excel(DATA_FILE)
    df.columns = ["seq", "I", "W", "beta", "theta", "gamma", "eps"]
    return df


def add_energy(df):
    df = df.copy()
    df["power_kw"] = POWER_I * df["I"] + POWER_W * df["W"]
    df["energy_cost_yuan_h"] = df["power_kw"] * ELECTRICITY_PRICE
    return df


def fit_response_surface(train_df):
    x = train_df[["I", "W"]].to_numpy()
    poly = PolynomialFeatures(degree=2, include_bias=True)
    x_poly = poly.fit_transform(x)
    models = {}
    metrics = []
    for target in TARGETS:
        model = LinearRegression()
        model.fit(x_poly, train_df[target].to_numpy())
        pred = model.predict(x_poly)
        models[target] = model
        rmse = rmse_score(train_df[target], pred)
        mae = mean_absolute_error(train_df[target], pred)
        n = len(train_df)
        p = x_poly.shape[1] - 1
        r2 = r2_score(train_df[target], pred)
        adj_r2 = 1 - (1 - r2) * (n - 1) / (n - p - 1)
        metrics.append(
            {
                "target": target,
                "r2": r2,
                "adj_r2": adj_r2,
                "rmse": rmse,
                "mae": mae,
                "formula": format_formula(model, poly, target),
            }
        )
    return poly, models, pd.DataFrame(metrics)


def fit_random_forest(train_df):
    x = train_df[["I", "W"]].to_numpy()
    models = {}
    metrics = []
    cv = KFold(n_splits=5, shuffle=True, random_state=42)
    for target in TARGETS:
        model = RandomForestRegressor(
            n_estimators=500,
            min_samples_leaf=2,
            random_state=42,
        )
        y = train_df[target].to_numpy()
        model.fit(x, y)
        pred = model.predict(x)
        cv_scores = cross_val_score(model, x, y, cv=cv, scoring="r2")
        models[target] = model
        metrics.append(
            {
                "target": target,
                "train_r2": r2_score(y, pred),
                "cv_r2_mean": cv_scores.mean(),
                "cv_r2_std": cv_scores.std(),
                "importance_I": model.feature_importances_[0],
                "importance_W": model.feature_importances_[1],
            }
        )
    return models, pd.DataFrame(metrics)


def format_formula(model, poly, target):
    names = poly.get_feature_names_out(["I", "W"])
    parts = []
    for coef, name in zip(model.coef_, names):
        if name == "1":
            continue
        parts.append(f"{coef:+.6f}*{name}")
    return f"{target} = {model.intercept_:.6f} " + " ".join(parts)


def predict(models, poly, grid_df):
    x_poly = poly.transform(grid_df[["I", "W"]].to_numpy())
    out = grid_df.copy()
    for target, model in models.items():
        out[target] = model.predict(x_poly)
    out = add_energy(out)
    return out


def predict_rf(models, grid_df):
    x = grid_df[["I", "W"]].to_numpy()
    out = grid_df.copy()
    for target, model in models.items():
        out[target] = model.predict(x)
    out["beta"] = out["beta"].clip(0, 100)
    out["theta"] = out["theta"].clip(0, 100)
    out["gamma"] = out["gamma"].clip(0, 100)
    out["eps"] = out["eps"].clip(0, 100)
    out = add_energy(out)
    return out


def pareto_front(feasible_df):
    df = feasible_df.sort_values(["power_kw", "gamma"], ascending=[True, False]).copy()
    keep = []
    best_gamma = -np.inf
    for idx, row in df.iterrows():
        if row["gamma"] > best_gamma + 1e-9:
            keep.append(idx)
            best_gamma = row["gamma"]
    return df.loc[keep].sort_values("power_kw").reset_index(drop=True)


def topsis_select(pareto_df, w_gamma=0.5, w_energy=0.5):
    df = pareto_df.copy()
    gamma_span = df["gamma"].max() - df["gamma"].min()
    energy_span = df["power_kw"].max() - df["power_kw"].min()
    gamma_norm = pd.Series(1.0, index=df.index) if gamma_span == 0 else (
        df["gamma"] - df["gamma"].min()
    ) / gamma_span
    energy_norm = pd.Series(1.0, index=df.index) if energy_span == 0 else (
        df["power_kw"].max() - df["power_kw"]
    ) / energy_span
    df["score"] = w_gamma * gamma_norm + w_energy * energy_norm
    return df.loc[df["score"].idxmax()], df


def minmax_series(s, benefit=True):
    span = s.max() - s.min()
    if span == 0:
        return pd.Series(1.0, index=s.index)
    if benefit:
        return (s - s.min()) / span
    return (s.max() - s) / span


def entropy_weight_topsis(pareto_df):
    df = pareto_df.copy().reset_index(drop=True)
    criteria = pd.DataFrame(
        {
            "yield_gamma": minmax_series(df["gamma"], benefit=True),
            "energy_saving": minmax_series(df["power_kw"], benefit=False),
            "grade_margin": minmax_series(df["beta"] - 67, benefit=True),
            "recovery_margin": minmax_series(df["eps"] - 95, benefit=True),
        }
    )
    eps = 1e-12
    p = (criteria + eps) / (criteria + eps).sum(axis=0)
    entropy = -(p * np.log(p)).sum(axis=0) / np.log(len(criteria))
    diversity = 1 - entropy
    weights = diversity / diversity.sum()

    weighted = criteria * weights
    ideal = weighted.max(axis=0)
    anti_ideal = weighted.min(axis=0)
    d_pos = np.sqrt(((weighted - ideal) ** 2).sum(axis=1))
    d_neg = np.sqrt(((weighted - anti_ideal) ** 2).sum(axis=1))
    df["score"] = d_neg / (d_pos + d_neg + eps)
    df["entropy_topsis_score"] = df["score"]
    weights_df = pd.DataFrame(
        {"criterion": weights.index, "weight": weights.to_numpy(), "entropy": entropy.to_numpy()}
    )
    return df.loc[df["score"].idxmax()], df, weights_df


def constraint_violation(df):
    return np.maximum(0, 67 - df["beta"]) + np.maximum(0, 95 - df["eps"])


def dominates_record(a, b):
    if a["violation"] < b["violation"] - 1e-9:
        return True
    if a["violation"] > b["violation"] + 1e-9:
        return False
    a_obj = np.array([-a["gamma"], a["power_kw"]])
    b_obj = np.array([-b["gamma"], b["power_kw"]])
    return np.all(a_obj <= b_obj + 1e-9) and np.any(a_obj < b_obj - 1e-9)


def non_dominated_sort(pop):
    records = pop.to_dict("records")
    n = len(records)
    dominates = [set() for _ in range(n)]
    dominated_count = np.zeros(n, dtype=int)
    fronts = [[]]
    for p in range(n):
        for q in range(n):
            if p == q:
                continue
            if dominates_record(records[p], records[q]):
                dominates[p].add(q)
            elif dominates_record(records[q], records[p]):
                dominated_count[p] += 1
        if dominated_count[p] == 0:
            fronts[0].append(p)

    i = 0
    while fronts[i]:
        next_front = []
        for p in fronts[i]:
            for q in dominates[p]:
                dominated_count[q] -= 1
                if dominated_count[q] == 0:
                    next_front.append(q)
        i += 1
        fronts.append(next_front)
    return fronts[:-1]


def crowding_distance(front_df):
    if len(front_df) <= 2:
        return pd.Series(np.inf, index=front_df.index)
    distance = pd.Series(0.0, index=front_df.index)
    for col, ascending in [("gamma", False), ("power_kw", True)]:
        sorted_idx = front_df.sort_values(col, ascending=ascending).index
        distance.loc[sorted_idx[0]] = np.inf
        distance.loc[sorted_idx[-1]] = np.inf
        span = front_df[col].max() - front_df[col].min()
        if span == 0:
            continue
        for k in range(1, len(sorted_idx) - 1):
            prev_val = front_df.loc[sorted_idx[k - 1], col]
            next_val = front_df.loc[sorted_idx[k + 1], col]
            distance.loc[sorted_idx[k]] += abs(next_val - prev_val) / span
    return distance


def assign_rank_and_crowding(pop):
    pop = pop.copy().reset_index(drop=True)
    pop["rank"] = np.inf
    pop["crowding"] = 0.0
    fronts = non_dominated_sort(pop)
    for rank, front in enumerate(fronts):
        idx = pop.index[front]
        pop.loc[idx, "rank"] = rank
        pop.loc[idx, "crowding"] = crowding_distance(pop.loc[idx])
    return pop


def predict_points(models, poly, points):
    return predict(models, poly, pd.DataFrame(points, columns=["I", "W"]))


def nsga2_optimize(models, poly, pop_size=80, generations=80, seed=42):
    rng = np.random.default_rng(seed)
    pop_points = np.column_stack(
        [
            rng.uniform(I_BOUNDS[0], I_BOUNDS[1], pop_size),
            rng.uniform(W_BOUNDS[0], W_BOUNDS[1], pop_size),
        ]
    )

    for _ in range(generations):
        pop = predict_points(models, poly, pop_points)
        pop["violation"] = constraint_violation(pop)
        pop = assign_rank_and_crowding(pop)

        parents = []
        for _ in range(pop_size):
            a, b = rng.integers(0, pop_size, 2)
            pa, pb = pop.iloc[a], pop.iloc[b]
            if (pa["rank"], -pa["crowding"]) <= (pb["rank"], -pb["crowding"]):
                parents.append(pop_points[a])
            else:
                parents.append(pop_points[b])
        parents = np.asarray(parents)

        children = []
        for k in range(0, pop_size, 2):
            p1 = parents[k]
            p2 = parents[(k + 1) % pop_size]
            alpha = rng.uniform(-0.15, 1.15, 2)
            c1 = alpha * p1 + (1 - alpha) * p2
            c2 = alpha * p2 + (1 - alpha) * p1
            for child in [c1, c2]:
                if rng.random() < 0.35:
                    child += rng.normal([0, 0], [0.025, 0.25])
                child[0] = np.clip(child[0], *I_BOUNDS)
                child[1] = np.clip(child[1], *W_BOUNDS)
                children.append(child)
        combined_points = np.vstack([pop_points, np.asarray(children[:pop_size])])
        combined = predict_points(models, poly, combined_points)
        combined["violation"] = constraint_violation(combined)
        combined = assign_rank_and_crowding(combined)
        combined["point_idx"] = np.arange(len(combined))
        combined = combined.sort_values(["rank", "crowding"], ascending=[True, False]).head(pop_size)
        pop_points = combined_points[combined["point_idx"].to_numpy()]

    final = predict_points(models, poly, pop_points)
    final["violation"] = constraint_violation(final)
    feasible = final[final["violation"] <= 1e-8].copy()
    if feasible.empty:
        return final, pd.DataFrame()
    return final, pareto_front(feasible)


def price_by_grade(beta):
    beta = np.asarray(beta)
    return np.where(beta >= 64, 800 + (beta - 64) * 15, 800 + (beta - 64) * 20)


def profit_per_hour(df, price_factor=1.0, electricity_factor=1.0):
    price = price_by_grade(df["beta"]) * price_factor
    concentrate_ton = FEED_TON_PER_HOUR * df["gamma"] / 100
    energy_cost = df["power_kw"] * ELECTRICITY_PRICE * electricity_factor
    return concentrate_ton * price - energy_cost


def make_grid():
    i_values = np.linspace(I_BOUNDS[0], I_BOUNDS[1], 401)
    w_values = np.linspace(W_BOUNDS[0], W_BOUNDS[1], 901)
    ii, ww = np.meshgrid(i_values, w_values)
    return pd.DataFrame({"I": ii.ravel(), "W": ww.ravel()})


def make_plot_grid(n_i=90, n_w=110):
    i_values = np.linspace(I_BOUNDS[0], I_BOUNDS[1], n_i)
    w_values = np.linspace(W_BOUNDS[0], W_BOUNDS[1], n_w)
    ii, ww = np.meshgrid(i_values, w_values)
    return ii, ww, pd.DataFrame({"I": ii.ravel(), "W": ww.ravel()})


def safe_to_csv(df, path):
    try:
        df.to_csv(path, index=False, encoding="utf-8-sig")
        return path
    except PermissionError:
        fallback = path.with_name(path.stem + "_new" + path.suffix)
        df.to_csv(fallback, index=False, encoding="utf-8-sig")
        return fallback


