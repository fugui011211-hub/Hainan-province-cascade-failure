def profit_risk_analysis(candidate_df, n_scenarios=1500, seed=42):
    rng = np.random.default_rng(seed)
    price_factor = rng.triangular(0.85, 1.0, 1.15, n_scenarios)
    electricity_factor = rng.triangular(0.8, 1.0, 1.2, n_scenarios)
    rows = []
    for _, row in candidate_df.iterrows():
        price = price_by_grade(row["beta"]) * price_factor
        concentrate_ton = FEED_TON_PER_HOUR * row["gamma"] / 100
        profit = concentrate_ton * price - row["power_kw"] * ELECTRICITY_PRICE * electricity_factor
        q10 = np.quantile(profit, 0.10)
        rows.append(
            {
                "I": row["I"],
                "W": row["W"],
                "beta": row["beta"],
                "gamma": row["gamma"],
                "eps": row["eps"],
                "power_kw": row["power_kw"],
                "expected_profit": profit.mean(),
                "profit_std": profit.std(ddof=1),
                "profit_q10": q10,
                "safety_margin": min(row["beta"] - 67, row["eps"] - 95),
                "risk_adjusted_profit": profit.mean() - 0.7 * profit.std(ddof=1),
            }
        )
    risk_df = pd.DataFrame(rows)
    risk_df["is_risk_pareto"] = False
    sorted_df = risk_df.sort_values(["profit_std", "expected_profit"], ascending=[True, False])
    best_profit = -np.inf
    keep = []
    for idx, row in sorted_df.iterrows():
        if row["expected_profit"] > best_profit + 1e-9:
            keep.append(idx)
            best_profit = row["expected_profit"]
    risk_df.loc[keep, "is_risk_pareto"] = True
    return risk_df


