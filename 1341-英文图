def robustness_map(models, poly, sigma_i=0.015, sigma_w=0.18, n_samples=220, seed=42):
    rng = np.random.default_rng(seed)
    ii, ww, base_df = make_plot_grid(65, 80)
    n_points = len(base_df)
    base_i = np.repeat(base_df["I"].to_numpy(), n_samples)
    base_w = np.repeat(base_df["W"].to_numpy(), n_samples)
    pert_i = np.clip(base_i + rng.normal(0, sigma_i, n_points * n_samples), *I_BOUNDS)
    pert_w = np.clip(base_w + rng.normal(0, sigma_w, n_points * n_samples), *W_BOUNDS)
    pred = predict(models, poly, pd.DataFrame({"I": pert_i, "W": pert_w}))
    pass_flag = ((pred["beta"].to_numpy() >= 67) & (pred["eps"].to_numpy() >= 95)).reshape(
        n_points, n_samples
    )
    robust = base_df.copy()
    robust["pass_probability"] = pass_flag.mean(axis=1)
    robust["I_grid"] = base_df["I"]
    robust["W_grid"] = base_df["W"]
    return ii, ww, robust


def robust_probability_for_solution(models, poly, solution, sigma_i, sigma_w, n_samples=8000, seed=42):
    rng = np.random.default_rng(seed)
    pert_i = np.clip(rng.normal(solution["I"], sigma_i, n_samples), *I_BOUNDS)
    pert_w = np.clip(rng.normal(solution["W"], sigma_w, n_samples), *W_BOUNDS)
    pred = predict(models, poly, pd.DataFrame({"I": pert_i, "W": pert_w}))
    pass_flag = (pred["beta"] >= 67) & (pred["eps"] >= 95)
    p = float(pass_flag.mean())
    se = np.sqrt(p * (1 - p) / n_samples)
    return p, max(0, p - 1.96 * se), min(1, p + 1.96 * se)


def robust_sensitivity(models, poly, selected, econ_df):
    baseline = econ_df[(econ_df["price_factor"] == 1.0) & (econ_df["electricity_factor"] == 1.0)].iloc[0]
    solutions = [
        {"scheme": "technical_entropy", "I": selected["I"], "W": selected["W"]},
        {"scheme": "economic_profit", "I": baseline["opt_I"], "W": baseline["opt_W"]},
    ]
    rows = []
    for scale in np.linspace(0.5, 2.5, 9):
        for sol in solutions:
            p, lo, hi = robust_probability_for_solution(
                models,
                poly,
                sol,
                sigma_i=0.012 * scale,
                sigma_w=0.12 * scale,
                n_samples=5000,
                seed=int(1000 * scale) + (0 if sol["scheme"] == "technical_entropy" else 17),
            )
            rows.append(
                {
                    "scheme": sol["scheme"],
                    "disturbance_scale": scale,
                    "sigma_I": 0.012 * scale,
                    "sigma_W": 0.12 * scale,
                    "pass_probability": p,
                    "ci_low": lo,
                    "ci_high": hi,
                }
            )
    return pd.DataFrame(rows)


