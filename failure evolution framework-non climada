        ax.set_xlabel("time")
        ax.set_ylabel("damaged line count")
        ax.grid(alpha=0.25)
        fig.autofmt_xdate()
        fig.tight_layout()
        fig.savefig(OUTPUT_DIR / "zhuhai_damage_count_timeline.png", dpi=200)
        plt.close(fig)

        print("Output: outputs/zhuhai_function_timeline.png")
        print("Output: outputs/zhuhai_metrics_timeline.png")
        print("Output: outputs/zhuhai_wind_timeline.png")
        print("Output: outputs/zhuhai_damage_count_timeline.png")
    except Exception as exc:
        print(f"Timeline figures skipped: {exc}")


