        ax.set_xlabel("time")
        ax.set_ylabel("function (%)")
        ax.grid(alpha=0.25)
        fig.autofmt_xdate()
        fig.tight_layout()
        fig.savefig(OUTPUT_DIR / "zhuhai_function_timeline.png", dpi=200)
        plt.close(fig)

        fig, ax = plt.subplots(figsize=(9, 4.5))
        ax.plot(time, timeline["KTE_norm"], label="KTE_norm", linewidth=1)
        ax.plot(time, timeline["KTR_norm"], label="KTR_norm", linewidth=1)
        ax.plot(time, timeline["KLC_norm"], label="KLC_norm", linewidth=1)
        ax.set_title("Zhuhai normalized functional metrics")
        ax.set_xlabel("time")
        ax.set_ylabel("normalized value")
        ax.legend()
        ax.grid(alpha=0.25)
        fig.autofmt_xdate()
        fig.tight_layout()
        fig.savefig(OUTPUT_DIR / "zhuhai_metrics_timeline.png", dpi=200)
        plt.close(fig)

        fig, ax = plt.subplots(figsize=(9, 4.5))
