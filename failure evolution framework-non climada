        ax.set_xlabel("time")
        ax.set_ylabel("wind speed (m/s)")
        ax.legend()
        ax.grid(alpha=0.25)
        fig.autofmt_xdate()
        fig.tight_layout()
        fig.savefig(OUTPUT_DIR / "zhuhai_wind_timeline.png", dpi=200)
